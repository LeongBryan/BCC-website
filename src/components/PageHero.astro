---
interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  cta?: CtaLink[];
}

const { eyebrow, title, description, image, imageAlt = "", cta = [] } = Astro.props as Props;
---

<section data-reveal class="grid gap-8 rounded-3xl border border-slate-200/70 bg-white/90 p-6 shadow-sm md:grid-cols-[1.1fr_0.9fr] md:items-center md:p-10">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600 md:text-lg">{description}</p>
    {
      cta.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {cta.map((item, index) => (
            <a
              href={item.href}
              class:list={["btn", index === 0 ? "btn-primary" : "btn-secondary"]}
            >
              {item.label}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    image && (
      <div class="relative overflow-hidden rounded-2xl border border-slate-200/70 bg-[var(--bcc-yellow)]/25">
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
          width="1000"
          height="750"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
</section>

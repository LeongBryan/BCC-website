---
interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  cta?: CtaLink[];
}

const { eyebrow, title, description, image, imageAlt = "", cta = [] } = Astro.props as Props;
---

<section class="grid gap-8 rounded-3xl border border-black/10 bg-white/90 p-6 shadow-sm md:grid-cols-[1.1fr_0.9fr] md:items-center md:p-10">
  <div class="animate-enter">
    {
      eyebrow && (
        <p class="inline-flex rounded-full bg-[var(--bcc-green)] px-3 py-1 text-xs font-black uppercase tracking-[0.12em] text-slate-900">
          {eyebrow}
        </p>
      )
    }
    <h1 class="mt-4 text-3xl font-black leading-tight tracking-tight text-slate-900 md:text-5xl">{title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-700 md:text-lg">{description}</p>
    {
      cta.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-3">
          {cta.map((item, index) => (
            <a
              href={item.href}
              class:list={[
                "rounded-xl px-4 py-2.5 text-sm font-black transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900",
                index === 0
                  ? "bg-slate-900 text-white hover:bg-slate-800"
                  : "bg-[var(--bcc-blue)] text-slate-900 hover:bg-sky-200",
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>
      )
    }
  </div>

  {
    image && (
      <div class="relative overflow-hidden rounded-2xl border border-black/10 bg-[var(--bcc-yellow)]/25">
        <img
          src={image}
          alt={imageAlt}
          class="h-full w-full object-cover"
          width="1000"
          height="750"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
</section>

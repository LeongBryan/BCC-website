---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import site from "../data/site.json";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = "/images/logo_transparent_bg.png" } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? new URL("https://bethesdachristiancentre.org"));
const ogImage = new URL(image, canonical);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={ogImage.toString()} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.toString()} />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
    <script is:inline>
      // Reveal-on-scroll: gate the hidden state on JS + motion preference, then
      // fade each section in as it enters the viewport. Setting the class here
      // (in <head>, before <body> paints) avoids any content flash.
      (function () {
        try {
          if (!("IntersectionObserver" in window)) return;
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          document.documentElement.classList.add("reveal-ready");
          document.addEventListener("DOMContentLoaded", function () {
            var io = new IntersectionObserver(
              function (entries) {
                entries.forEach(function (entry) {
                  if (!entry.isIntersecting) return;
                  var el = entry.target;
                  if (el.hasAttribute("data-stagger")) {
                    // Cascade the container's children in one by one.
                    Array.prototype.forEach.call(el.children, function (child, i) {
                      child.style.transitionDelay = i * 70 + "ms";
                      child.classList.add("is-visible");
                    });
                  } else {
                    el.classList.add("is-visible");
                  }
                  io.unobserve(el);
                });
              },
              { rootMargin: "0px 0px -8% 0px", threshold: 0.05 }
            );
            document
              .querySelectorAll("[data-reveal], [data-stagger]")
              .forEach(function (el) {
                io.observe(el);
              });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="font-sans antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="mx-auto w-full max-w-6xl px-4 py-8 md:px-6 md:py-12">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

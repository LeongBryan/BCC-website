---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="READ/LEARN@W11 | Bethesda Christian Centre">
  <section class="rounded-2xl border border-black/10 bg-white/90 p-8 shadow-sm md:p-10">
    <h1 class="text-3xl font-black tracking-tight text-slate-900 md:text-4xl">READ/LEARN@W11</h1>
    <p class="mt-4 max-w-3xl text-slate-700">
      This route is preserved and ready for content migration of READ@W11 and LEARN@W11 details, timings, and signup
      CTAs.
    </p>
  </section>
</BaseLayout>

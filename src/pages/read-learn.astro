---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import readLearn from "../data/read-learn.json";
import { readdirSync } from "node:fs";
import { extname } from "node:path";

const imageExtensions = new Set([".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif"]);

const listPublicImages = (folderName: string) => {
  const folderUrl = new URL(`../../public/images/readnlearn/${folderName}/`, import.meta.url);
  try {
    return readdirSync(folderUrl, { withFileTypes: true })
      .filter((entry) => entry.isFile())
      .map((entry) => entry.name)
      .filter((name) => imageExtensions.has(extname(name).toLowerCase()))
      .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
      .map((name) => `/images/readnlearn/${folderName}/${encodeURIComponent(name)}`);
  } catch {
    return [];
  }
};

const galleryImages = listPublicImages("gallery");
const posterImages = listPublicImages("posters");
---

<BaseLayout
  title="READ/LEARN@W11"
  description="READ@W11 and LEARN@W11 literacy and tuition programs."
  image="/images/read_logo.png"
>
  <PageHero
    eyebrow="READ/LEARN@W11"
    title={readLearn.title}
    description={readLearn.intro}
    image="/images/read_logo.png"
    imageAlt="READ@W11 logo"
    cta={[{ label: readLearn.cta.label, href: readLearn.cta.href }]}
  />

  <section aria-labelledby="programs" class="mt-10">
    <h2 data-reveal id="programs" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Programs</h2>
    <div data-stagger class="mt-5 grid gap-6 md:grid-cols-2">
      {
        readLearn.programs.map((program) => (
          <article class="rounded-2xl border border-slate-200/70 bg-white/90 p-6 shadow-sm">
            <div>
              <h3 class="text-2xl font-bold tracking-tight text-slate-900">{program.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-700">{program.description}</p>
              <p class="mt-4 text-sm text-slate-700">
                <span class="font-bold text-slate-900">Time:</span> {program.time}
              </p>
              <p class="mt-1 text-sm text-slate-700">
                <span class="font-bold text-slate-900">Location:</span>
                <a
                  href={program.locationLink}
                  target="_blank"
                  rel="noreferrer"
                  class="ml-1 link"
                >
                  {program.location}
                </a>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="past-events" class="mt-12">
    <h2 data-reveal id="past-events" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Past Events</h2>
    {
      posterImages.length > 0 ? (
        <div data-stagger class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {posterImages.map((image, index) => (
            <figure class="overflow-hidden rounded-xl border border-slate-200/70 bg-white/95 shadow-sm">
              <img
                src={image}
                alt={`READ/LEARN poster ${index + 1}`}
                loading="lazy"
                class="h-80 w-full bg-white object-contain"
              />
            </figure>
          ))}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-black/20 bg-white/70 px-4 py-3 text-sm text-slate-600">
          Past event posters will appear here once images are added.
        </p>
      )
    }
  </section>

  <section aria-labelledby="photo-gallery" class="mt-12">
    <h2 data-reveal id="photo-gallery" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Photo Gallery</h2>
    {
      galleryImages.length > 0 ? (
        <div data-stagger class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {galleryImages.map((image, index) => (
            <figure class="overflow-hidden rounded-xl border border-slate-200/70 bg-white/95 shadow-sm">
              <img
                src={image}
                alt={`READ/LEARN gallery photo ${index + 1}`}
                loading="lazy"
                class="h-56 w-full object-cover"
              />
            </figure>
          ))}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-black/20 bg-white/70 px-4 py-3 text-sm text-slate-600">
          Photo gallery images will appear here once images are added.
        </p>
      )
    }
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import home from "../data/home.json";
import site from "../data/site.json";
---

<BaseLayout title="Home" description={site.description} image={home.hero.image}>
  {
    home.announcements && home.announcements.length > 0 && (
      <section
        data-reveal
        aria-labelledby="announcements-heading"
        class="mb-8 overflow-hidden rounded-2xl border border-amber-300/70 bg-[var(--bcc-yellow)]/45 shadow-sm"
      >
        <details open class="announcement-panel">
          <summary class="flex cursor-pointer list-none flex-wrap items-center justify-between gap-3 p-5 md:px-7 md:py-6 [&::-webkit-details-marker]:hidden">
            <div class="flex items-center gap-3">
              <span aria-hidden="true" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-900 text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                  <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                </svg>
              </span>
              <h2
                id="announcements-heading"
                class="text-lg font-bold tracking-tight text-slate-900 md:text-xl"
              >
                Announcements
              </h2>
            </div>
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                Important
              </span>
              <span
                aria-hidden="true"
                class="announcement-toggle inline-flex h-9 w-9 items-center justify-center rounded-full border border-slate-300 bg-white text-slate-900"
              >
                <svg
                  class="announcement-toggle-icon h-4 w-4"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 8l5 5 5-5"></path>
                </svg>
              </span>
            </div>
            <span class="sr-only">Toggle announcements list</span>
          </summary>
          <div class="space-y-3 px-5 pb-5 md:px-7 md:pb-7">
            {
              home.announcements.map((announcement) => (
                <article class="rounded-xl border border-slate-200 bg-white p-4 text-slate-900 shadow-sm">
                  <p class="text-xs font-semibold uppercase tracking-[0.1em] text-slate-500">
                    {announcement.dateLabel}
                  </p>
                  <h3 class="mt-1 text-lg font-bold tracking-tight md:text-xl">{announcement.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-600 md:text-base">{announcement.message}</p>
                </article>
              ))
            }
          </div>
        </details>
      </section>
    )
  }

  <PageHero
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    description={home.hero.description}
    image={home.hero.image}
    imageAlt={home.hero.imageAlt}
    cta={home.hero.cta}
  />

  <section aria-labelledby="quick-links" class="card mt-8 p-6 md:p-8">
    <h2 data-reveal id="quick-links" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Plan Your First Visit</h2>
    <div data-stagger class="mt-5 grid gap-4 md:grid-cols-3">
      <article class="info-card tint-green">
        <span class="info-icon" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
        </span>
        <div>
          <p class="info-label">Service Times</p>
          <p class="info-value">{site.serviceTimes.join(" and ")}</p>
        </div>
      </article>
      <article class="info-card tint-blue">
        <span class="info-icon" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" />
          </svg>
        </span>
        <div>
          <p class="info-label">Location</p>
          <p class="info-value">
            <a href={site.serviceLocationLink} target="_blank" rel="noreferrer" class="link decoration-slate-300">{site.addressLines[0]}</a>
          </p>
        </div>
      </article>
      <article class="info-card tint-yellow">
        <span class="info-icon" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
          </svg>
        </span>
        <div>
          <p class="info-label">Contact</p>
          <p class="info-value">
            <a href={`mailto:${site.email}`} class="link decoration-slate-300">{site.email}</a>
          </p>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="featured-sections" class="mt-10">
    <h2 data-reveal id="featured-sections" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Explore</h2>
    <div data-stagger class="mt-5 grid gap-6 md:grid-cols-3">
      {
        home.sections.map((section) => (
          <a
            href={section.href}
            class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200/70 bg-white/90 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
          >
            <div class="overflow-hidden">
              <img
                src={section.image}
                alt={section.imageAlt}
                width="640"
                height="420"
                loading="lazy"
                class="h-48 w-full object-cover transition duration-300 group-hover:scale-[1.03]"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-xl font-bold tracking-tight text-slate-900">{section.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{section.description}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-slate-900">
                {section.linkLabel}
                <svg class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 10h12M11 5l5 5-5 5" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .announcement-toggle-icon {
    transition: transform 0.16s ease;
  }

  details.announcement-panel:not([open]) .announcement-toggle-icon {
    transform: rotate(-90deg);
  }

  details.announcement-panel > summary:hover .announcement-toggle {
    background: #0f172a;
    color: #ffffff;
  }

  details.announcement-panel > summary:active .announcement-toggle {
    background: #1e293b;
    color: #ffffff;
  }
</style>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import home from "../data/home.json";
import site from "../data/site.json";
---

<BaseLayout title="Home" description={site.description} image={home.hero.image}>
  {
    home.announcements && home.announcements.length > 0 && (
      <section
        aria-labelledby="announcements-heading"
        class="mb-8 rounded-3xl border-4 border-slate-900 bg-[var(--bcc-yellow)] p-5 shadow-[0_0_0_6px_rgba(0,0,0,0.08)] md:p-7"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2
            id="announcements-heading"
            class="text-xl font-black uppercase tracking-[0.08em] text-slate-900 md:text-2xl"
          >
            Announcements
          </h2>
          <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-black uppercase tracking-wide text-white">
            Important
          </span>
        </div>
        <div class="mt-4 space-y-3">
          {
            home.announcements.map((announcement, index) => (
              <article
                class:list={[
                  "rounded-2xl border border-slate-900/20 p-4",
                  index === 0 ? "bg-white text-slate-900" : "bg-slate-50 text-slate-800",
                ]}
              >
                <p class="text-xs font-black uppercase tracking-[0.1em] text-slate-600">
                  {announcement.dateLabel}
                </p>
                <h3 class="mt-1 text-lg font-black tracking-tight md:text-xl">{announcement.title}</h3>
                <p class="mt-2 text-sm leading-relaxed md:text-base">{announcement.message}</p>
              </article>
            ))
          }
        </div>
      </section>
    )
  }

  <PageHero
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    description={home.hero.description}
    image={home.hero.image}
    imageAlt={home.hero.imageAlt}
    cta={home.hero.cta}
  />

  <section aria-labelledby="quick-links" class="mt-8 rounded-2xl border border-black/10 bg-white/85 p-6 md:p-8">
    <h2 id="quick-links" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Plan Your First Visit</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <h3 class="text-base font-black text-slate-900">Service Times</h3>
        <p class="mt-2 text-sm text-slate-700">{site.serviceTimes.join(" and ")}</p>
      </article>
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <h3 class="text-base font-black text-slate-900">Location</h3>
        <p class="mt-2 text-sm text-slate-700">{site.addressLines[0]}</p>
      </article>
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <h3 class="text-base font-black text-slate-900">Contact</h3>
        <p class="mt-2 text-sm text-slate-700">{site.email}</p>
      </article>
    </div>
  </section>

  <section aria-labelledby="featured-sections" class="mt-10">
    <h2 id="featured-sections" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Explore</h2>
    <div class="mt-5 grid gap-6 md:grid-cols-3">
      {
        home.sections.map((section) => (
          <article class="group overflow-hidden rounded-2xl border border-black/10 bg-white/90 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
            <img
              src={section.image}
              alt={section.imageAlt}
              width="640"
              height="420"
              loading="lazy"
              class="h-48 w-full object-cover"
            />
            <div class="p-5">
              <h3 class="text-xl font-black tracking-tight text-slate-900">{section.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-700">{section.description}</p>
              <a
                href={section.href}
                class="mt-4 inline-block rounded-lg bg-[var(--bcc-yellow)] px-3 py-2 text-sm font-black text-slate-900 transition group-hover:bg-[var(--bcc-green)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
              >
                {section.linkLabel}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

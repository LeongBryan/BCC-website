---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import contact from "../data/contact.json";
import site from "../data/site.json";

const introItem = contact.intro[0];
---

<BaseLayout
  title="Get in Touch"
  description="Contact Bethesda Christian Centre and plan your visit."
  image="/images/logo_transparent_bg.png"
>
  <PageHero
    eyebrow="Get In Touch"
    title={contact.title}
    description="We’d love to hear from you and help you get connected."
    image="/images/logo_transparent_bg.png"
    imageAlt="Bethesda Christian Centre logo"
    cta={[
      { label: "Email us", href: `mailto:${contact.contact.email}` },
      { label: "Call us", href: `tel:${contact.contact.phone}` }
    ]}
  />

  <section aria-labelledby="reach-us" class="mt-8 rounded-2xl border border-black/10 bg-white/90 p-6 md:p-8">
    <h2 id="reach-us" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">How To Reach Us</h2>
    <p class="mt-4 text-base leading-relaxed text-slate-700">
      Our regular worship location at
      <a
        href={introItem.links[0].href}
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
        target="_blank"
        rel="noreferrer"
      >
        {introItem.links[0].label}
      </a>
      is a
      <a
        href={introItem.links[1].href}
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
        target="_blank"
        rel="noreferrer"
      >
        {" "}
        {introItem.links[1].label}
      </a>
      from Admiralty MRT Station, with a variety of
      <a
        href={introItem.links[2].href}
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
        target="_blank"
        rel="noreferrer"
      >
        {" "}
        {introItem.links[2].label}
      </a>.
    </p>
    <p class="mt-4 text-base text-slate-700">
      Contact us at
      <a
        href={`mailto:${contact.contact.email}`}
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        {" "}
        {contact.contact.email}
      </a>
      or
      <a
        href={`tel:${contact.contact.phone}`}
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        {" "}
        {contact.contact.phoneDisplay}
      </a>.
    </p>
  </section>

  <section aria-labelledby="contact-form" class="mt-8 grid gap-6 lg:grid-cols-[1fr_1fr]">
    <div class="rounded-2xl border border-black/10 bg-white/90 p-6">
      <h2 id="contact-form" class="text-2xl font-black tracking-tight text-slate-900">Quick Contact Form</h2>
      <p class="mt-3 text-sm text-slate-700">
        This static form opens your email client. You may also email us directly if you prefer.
      </p>
      <form
        action={`mailto:${contact.contact.email}`}
        method="post"
        enctype="text/plain"
        class="mt-5 space-y-4"
      >
        <label class="block text-sm font-bold text-slate-800" for="name">
          Name
        </label>
        <input
          id="name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-slate-700 focus:outline-none"
        />

        <label class="block text-sm font-bold text-slate-800" for="email">
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-slate-700 focus:outline-none"
        />

        <label class="block text-sm font-bold text-slate-800" for="interest">
          I am interested in
        </label>
        <select
          id="interest"
          name="interest"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-slate-700 focus:outline-none"
        >
          <option>Sunday Service</option>
          <option>Small Gatherings</option>
          <option>READ/LEARN@W11</option>
          <option>Just Looking Bible Study</option>
        </select>

        <label class="block text-sm font-bold text-slate-800" for="message">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          rows="4"
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-slate-700 focus:outline-none"
        ></textarea>

        <button
          type="submit"
          class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-black text-white hover:bg-slate-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
        >
          Send
        </button>
      </form>
    </div>

    <div class="rounded-2xl border border-black/10 bg-white/90 p-6">
      <h2 class="text-2xl font-black tracking-tight text-slate-900">Address</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-700">
        {site.addressLines[0]}<br />
        {site.addressLines[1]}
      </p>
      <div class="mt-4 overflow-hidden rounded-xl border border-slate-200">
        <iframe
          src={site.mapEmbedUrl}
          title="Map location of Bethesda Christian Centre"
          width="700"
          height="280"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="h-72 w-full border-0"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

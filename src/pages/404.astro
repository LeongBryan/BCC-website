---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="The page you requested could not be found.">
  <section class="rounded-2xl border border-black/10 bg-white/90 p-8 text-center md:p-12">
    <p class="text-sm font-black uppercase tracking-[0.12em] text-slate-600">404</p>
    <h1 class="mt-3 text-3xl font-black tracking-tight text-slate-900 md:text-5xl">Page Not Found</h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-slate-700">
      The link may be outdated or the page may have moved. Use the links below to continue browsing.
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/index.html"
        class="rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-black text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Home
      </a>
      <a
        href="/sunday-service.html"
        class="rounded-lg bg-[var(--bcc-blue)] px-4 py-2.5 text-sm font-black text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Sunday Service
      </a>
      <a
        href="/get-in-touch.html"
        class="rounded-lg bg-[var(--bcc-yellow)] px-4 py-2.5 text-sm font-black text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Get in Touch
      </a>
    </div>
  </section>
</BaseLayout>

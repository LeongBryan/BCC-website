---
import BaseLayout from "../layouts/BaseLayout.astro";
import beliefs from "../data/beliefs.json";
---

<BaseLayout
  title="Our Beliefs"
  description="Statement of faith and practices at Bethesda Christian Centre."
  image="/images/logo_transparent_bg.png"
>
  <section class="rounded-3xl border border-black/10 bg-white/90 p-6 shadow-sm md:p-10">
    <p class="inline-flex rounded-full bg-[var(--bcc-green)] px-3 py-1 text-xs font-black uppercase tracking-[0.12em] text-slate-900">
      Our Beliefs
    </p>
    <h1 class="mt-4 text-3xl font-black tracking-tight text-slate-900 md:text-5xl">Statement Of Faith</h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-700 md:text-lg">{beliefs.intro}</p>
    <nav aria-label="Beliefs sections" class="mt-5 flex flex-wrap gap-3">
      <a
        href="#statement-of-faith"
        class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-black text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Statement of Faith
      </a>
      <a
        href="#practices"
        class="rounded-lg bg-[var(--bcc-blue)] px-3 py-2 text-sm font-black text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Practices
      </a>
    </nav>
  </section>

  <section id="statement-of-faith" aria-labelledby="statement-title" class="mt-10">
    <h2 id="statement-title" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Statement of Faith</h2>
    <ol class="mt-5 space-y-4">
      {
        beliefs.statementOfFaith.map((item, index) => (
          <li class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
            <h3 class="text-lg font-black leading-tight text-slate-900">
              <span class="mr-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[var(--bcc-yellow)] text-sm">
                {index + 1}
              </span>
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{item.summary}</p>
            <p class="mt-2 text-xs leading-relaxed text-slate-500">{item.references}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="practices" aria-labelledby="practices-title" class="mt-12">
    <h2 id="practices-title" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Practices</h2>
    <ol class="mt-5 space-y-4">
      {
        beliefs.practices.map((item, index) => (
          <li class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
            <h3 class="text-lg font-black leading-tight text-slate-900">
              <span class="mr-2 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[var(--bcc-blue)] text-sm">
                {index + 1}
              </span>
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{item.summary}</p>
            <p class="mt-2 text-xs leading-relaxed text-slate-500">{item.references}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-10 rounded-2xl border border-black/10 bg-white/90 p-6">
    <h2 class="text-xl font-black text-slate-900">Further Reading</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-700">
      For more detailed confessional material, see
      <a
        href={beliefs.furtherReading.href}
        target="_blank"
        rel="noreferrer"
        class="font-bold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        {beliefs.furtherReading.label}
      </a>.
    </p>
  </section>
</BaseLayout>

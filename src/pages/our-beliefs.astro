---
import BaseLayout from "../layouts/BaseLayout.astro";
import beliefs from "../data/beliefs.json";
---

<BaseLayout
  title="Our Beliefs"
  description="Statement of faith and practices at Bethesda Christian Centre."
  image="/images/logo_transparent_bg.png"
>
  <section data-reveal class="rounded-3xl glass p-6 md:p-10">
    <p class="eyebrow">Our Beliefs</p>
    <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 md:text-5xl">Statement Of Faith</h1>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 md:text-lg">{beliefs.intro}</p>
    <nav aria-label="Beliefs sections" class="mt-5 flex flex-wrap gap-3">
      <a href="#statement-of-faith" class="btn btn-primary btn-sm">Statement of Faith</a>
      <a href="#practices" class="btn btn-secondary btn-sm">Practices</a>
    </nav>
  </section>

  <section id="statement-of-faith" aria-labelledby="statement-title" class="mt-10">
    <h2 data-reveal id="statement-title" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Statement of Faith</h2>
    <ol data-stagger class="mt-5 space-y-3">
      {
        beliefs.statementOfFaith.map((item, index) => (
          <li>
            <details class="belief glass rounded-2xl">
              <summary class="flex cursor-pointer list-none items-center gap-3 p-4 md:p-5 [&::-webkit-details-marker]:hidden">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--bcc-yellow)] text-sm font-bold text-slate-900">
                  {index + 1}
                </span>
                <h3 class="flex-1 text-base font-bold leading-tight text-slate-900 md:text-lg">{item.title}</h3>
                <svg class="belief-chevron h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8l5 5 5-5" /></svg>
              </summary>
              <div class="border-t border-slate-200/70 px-4 pb-4 pt-3 md:px-5 md:pb-5 md:pl-16">
                <p class="text-sm leading-relaxed text-slate-700">{item.summary}</p>
                <p class="mt-2 text-xs leading-relaxed text-slate-500">{item.references}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <section id="practices" aria-labelledby="practices-title" class="mt-12">
    <h2 data-reveal id="practices-title" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Practices</h2>
    <ol data-stagger class="mt-5 space-y-3">
      {
        beliefs.practices.map((item, index) => (
          <li>
            <details class="belief glass rounded-2xl">
              <summary class="flex cursor-pointer list-none items-center gap-3 p-4 md:p-5 [&::-webkit-details-marker]:hidden">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[var(--bcc-blue)] text-sm font-bold text-slate-900">
                  {index + 1}
                </span>
                <h3 class="flex-1 text-base font-bold leading-tight text-slate-900 md:text-lg">{item.title}</h3>
                <svg class="belief-chevron h-5 w-5 shrink-0 text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8l5 5 5-5" /></svg>
              </summary>
              <div class="border-t border-slate-200/70 px-4 pb-4 pt-3 md:px-5 md:pb-5 md:pl-16">
                <p class="text-sm leading-relaxed text-slate-700">{item.summary}</p>
                <p class="mt-2 text-xs leading-relaxed text-slate-500">{item.references}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <section data-reveal class="mt-10 rounded-2xl glass p-6">
    <h2 class="text-xl font-bold text-slate-900">Further Reading</h2>
    <p class="mt-3 text-sm leading-relaxed text-slate-700">
      For more detailed confessional material, see
      <a
        href={beliefs.furtherReading.href}
        target="_blank"
        rel="noreferrer"
        class="link"
      >
        {beliefs.furtherReading.label}
      </a>.
    </p>
  </section>
</BaseLayout>

<style>
  .belief-chevron {
    transition: transform 0.2s ease;
  }

  details.belief[open] .belief-chevron {
    transform: rotate(180deg);
  }

  details.belief > summary {
    transition: background-color 0.15s ease;
    border-radius: 1rem;
  }

  details.belief[open] > summary {
    border-radius: 1rem 1rem 0 0;
  }

  details.belief > summary:hover {
    background-color: rgba(15, 23, 42, 0.035);
  }
</style>

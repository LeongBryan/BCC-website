---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Stashed Content" description="Legacy supplemental content preserved during migration.">
  <section data-reveal class="rounded-2xl glass p-6 md:p-8">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 md:text-4xl">Legacy Supplemental Content</h1>
    <p class="mt-4 text-sm leading-relaxed text-slate-700">
      This route remains available for backward compatibility while the main About page now includes the updated
      leadership and staff profiles.
    </p>
    <p class="mt-4 text-sm">
      <a
        href="/about.html#leadership"
        class="link"
      >
        View our current leadership team on About Us
      </a>
    </p>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Stashed Content" description="Legacy supplemental content preserved during migration.">
  <section class="rounded-2xl border border-black/10 bg-white/90 p-6 md:p-8">
    <h1 class="text-3xl font-black tracking-tight text-slate-900 md:text-4xl">Legacy Supplemental Content</h1>
    <p class="mt-4 text-sm leading-relaxed text-slate-700">
      This route remains available for backward compatibility while the main About page now includes the updated
      leadership and staff profiles.
    </p>
    <p class="mt-4 text-sm">
      <a
        href="/about.html#daniel-lee"
        class="font-bold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        View Daniel Lee’s profile on About Us
      </a>
    </p>
  </section>
</BaseLayout>

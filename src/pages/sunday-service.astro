---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import sundayService from "../data/sunday-service.json";
---

<BaseLayout
  title="Sunday Service"
  description="Service timings, location, and what to expect at Sunday Service."
  image={sundayService.image}
>
  <PageHero
    eyebrow="Sunday Service"
    title="Join Us This Sunday"
    description={sundayService.intro[0]}
    image={sundayService.image}
    imageAlt={sundayService.imageAlt}
    cta={[
      { label: "Get directions", href: sundayService.locationLink },
      { label: "Contact us", href: "/get-in-touch.html" }
    ]}
  />

  <section aria-labelledby="what-to-expect" class="mt-8 rounded-2xl glass p-6 md:p-8">
    <h2 data-reveal id="what-to-expect" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">What To Expect</h2>
    <div data-reveal class="mt-4 space-y-3 text-base leading-relaxed text-slate-700">
      {
        sundayService.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <div data-stagger class="mt-6 grid gap-4 sm:grid-cols-2">
      <article class="info-card tint-green">
        <span class="info-icon" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
          </svg>
        </span>
        <div>
          <p class="info-label">Service Timings</p>
          <p class="info-value">{sundayService.serviceTimes}</p>
        </div>
      </article>
      <article class="info-card tint-blue">
        <span class="info-icon" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" />
          </svg>
        </span>
        <div>
          <p class="info-label">Location</p>
          <p class="info-value">
            <a href={sundayService.locationLink} target="_blank" rel="noreferrer" class="link">
              {sundayService.locationLabel}
            </a>
          </p>
        </div>
      </article>
    </div>

    <div data-reveal class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
      <img
        src={sundayService.detailsImage}
        alt={sundayService.detailsImageAlt}
        width="1600"
        height="900"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section aria-labelledby="sermon-sample" class="mt-8 rounded-2xl glass p-6 md:p-8">
    <h2 data-reveal id="sermon-sample" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Sample Sermon</h2>
    <p data-reveal class="mt-3 text-slate-700">
      <span class="font-bold">{sundayService.sermonSample.title}</span> -
      <a
        href={sundayService.sermonSample.passageLink}
        target="_blank"
        rel="noreferrer"
        class="link"
      >
        {sundayService.sermonSample.passage}
      </a>
    </p>
    <audio controls preload="none" class="mt-4 w-full">
      <source src={sundayService.sermonSample.audioSrc} type="audio/mp3" />
      Your browser does not support audio playback.
    </audio>
  </section>
</BaseLayout>

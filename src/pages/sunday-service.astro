---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import sundayService from "../data/sunday-service.json";
---

<BaseLayout
  title="Sunday Service"
  description="Service timings, location, and what to expect at Sunday Service."
  image={sundayService.image}
>
  <PageHero
    eyebrow="Sunday Service"
    title="Join Us This Sunday"
    description={sundayService.intro[0]}
    image={sundayService.image}
    imageAlt={sundayService.imageAlt}
    cta={[
      { label: "Get directions", href: sundayService.locationLink },
      { label: "Contact us", href: "/get-in-touch.html" }
    ]}
  />

  <section aria-labelledby="what-to-expect" class="mt-8 rounded-2xl border border-black/10 bg-white/90 p-6 md:p-8">
    <h2 id="what-to-expect" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">What To Expect</h2>
    <div class="mt-4 space-y-3 text-base leading-relaxed text-slate-700">
      {
        sundayService.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <h3 class="text-sm font-black uppercase tracking-wide text-slate-900">Service Timings</h3>
        <p class="mt-2 text-base font-semibold text-slate-800">{sundayService.serviceTimes}</p>
      </article>
      <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <h3 class="text-sm font-black uppercase tracking-wide text-slate-900">Location</h3>
        <p class="mt-2 text-base font-semibold text-slate-800">
          <a
            href={sundayService.locationLink}
            target="_blank"
            rel="noreferrer"
            class="underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
          >
            {sundayService.locationLabel}
          </a>
        </p>
      </article>
    </div>

    <div class="mt-5 overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
      <img
        src={sundayService.detailsImage}
        alt={sundayService.detailsImageAlt}
        width="1600"
        height="900"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
  </section>

  <section aria-labelledby="sermon-sample" class="mt-8 rounded-2xl border border-black/10 bg-white/90 p-6 md:p-8">
    <h2 id="sermon-sample" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Sample Sermon</h2>
    <p class="mt-3 text-slate-700">
      <span class="font-bold">{sundayService.sermonSample.title}</span> -
      <a
        href={sundayService.sermonSample.passageLink}
        target="_blank"
        rel="noreferrer"
        class="font-semibold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        {sundayService.sermonSample.passage}
      </a>
    </p>
    <audio controls preload="none" class="mt-4 w-full">
      <source src={sundayService.sermonSample.audioSrc} type="audio/mp3" />
      Your browser does not support audio playback.
    </audio>
  </section>
</BaseLayout>

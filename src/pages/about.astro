---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import about from "../data/about.json";

const hiddenLeaderIds = new Set(["daniel-lee"]);
const visibleLeaders = about.leaders.filter((person) => !hiddenLeaderIds.has(person.id));
const elders = visibleLeaders.filter((person) => person.team === "Elders and Deacons");
const staff = visibleLeaders.filter((person) => person.team === "Staff");
---

<BaseLayout
  title="About Us"
  description="Learn about Bethesda Christian Centre's story, vision, and leadership team."
  image="/images/logo_transparent_bg.png"
>
  <PageHero
    eyebrow="About Us"
    title="Our Story And Vision"
    description={about.intro[0]}
    image="/images/logo_transparent_bg.png"
    imageAlt="Bethesda Christian Centre logo"
  />

  <section aria-labelledby="about-story" class="mt-8 rounded-2xl glass p-6 md:p-8">
    <h2 data-reveal id="about-story" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Who We Are</h2>
    <div data-reveal class="mt-4 space-y-3 text-base leading-relaxed text-slate-700">
      {
        about.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>
    <div data-stagger class="mt-6 grid gap-4 md:grid-cols-3">
      {
        about.vision.map((item, index) => (
          <article class:list={["rounded-xl border p-5", ["tint-green", "tint-yellow", "tint-blue"][index % 3]]}>
            <h3 class="text-lg font-bold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-700">{item.description}</p>
          </article>
        ))
      }
    </div>
    <p data-reveal class="mt-6 text-sm font-semibold text-slate-700">
      Read more about our statement of faith on
      <a
        href="/our-beliefs.html"
        class="link"
      >
        Our Beliefs
      </a>.
    </p>
  </section>

  <section aria-labelledby="leadership" class="mt-10">
    <h2 data-reveal id="leadership" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Elders and Deacons</h2>
    <div data-stagger class="team-grid team-grid--3 mt-6">
      {
        elders.map((person) => (
          <div class="team-member group relative rounded-2xl text-center has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-slate-900">
            <img
              src={person.image}
              alt={`Portrait of ${person.name}`}
              class="mx-auto h-28 w-28 rounded-full object-cover shadow-sm ring-1 ring-slate-900/10 transition duration-200 group-hover:-translate-y-1 group-hover:shadow-lg"
              width="160"
              height="160"
              loading="lazy"
            />
            <h3 class="mt-4 text-base font-bold text-slate-900">{person.name}</h3>
            <p class="text-sm font-semibold text-slate-600">{person.role}</p>
            <span class="mt-1.5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-slate-400 transition-colors group-hover:text-slate-900">
              View bio
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
            <button
              type="button"
              data-open-bio={`bio-${person.id}`}
              class="absolute inset-0 cursor-pointer rounded-2xl focus:outline-none"
              aria-label={`Read ${person.name}'s biography`}
            />
          </div>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="staff" class="mt-10">
    <h2 data-reveal id="staff" class="text-2xl font-extrabold tracking-tight text-slate-900 md:text-3xl">Staff</h2>
    <div data-stagger class="team-grid team-grid--4 mt-6">
      {
        staff.map((person) => (
          <div class="team-member group relative rounded-2xl text-center has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-4 has-[:focus-visible]:outline-slate-900">
            <img
              src={person.image}
              alt={`Portrait of ${person.name}`}
              class="mx-auto h-28 w-28 rounded-full object-cover shadow-sm ring-1 ring-slate-900/10 transition duration-200 group-hover:-translate-y-1 group-hover:shadow-lg"
              width="160"
              height="160"
              loading="lazy"
            />
            <h3 class="mt-4 text-base font-bold text-slate-900">{person.name}</h3>
            <p class="text-sm font-semibold text-slate-600">{person.role}</p>
            <span class="mt-1.5 inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-slate-400 transition-colors group-hover:text-slate-900">
              View bio
              <svg class="h-3.5 w-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" /></svg>
            </span>
            <button
              type="button"
              data-open-bio={`bio-${person.id}`}
              class="absolute inset-0 cursor-pointer rounded-2xl focus:outline-none"
              aria-label={`Read ${person.name}'s biography`}
            />
          </div>
        ))
      }
    </div>
  </section>

  {
    visibleLeaders.map((person) => (
      <dialog
        id={`bio-${person.id}`}
        data-bio-dialog
        aria-labelledby={`bio-title-${person.id}`}
        class="bio-dialog rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-950/55"
      >
        <article class="max-h-[85vh] w-full max-w-2xl overflow-auto p-5 md:p-7">
          <div class="mb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <img
                src={person.image}
                alt={`Portrait of ${person.name}`}
                width="64"
                height="64"
                class="h-14 w-14 rounded-full border border-slate-200 object-cover"
              />
              <div>
                <h3 id={`bio-title-${person.id}`} class="text-xl font-bold tracking-tight text-slate-900">{person.name}</h3>
                <p class="text-sm font-semibold text-slate-600">{person.role}</p>
              </div>
            </div>
            <button
              type="button"
              data-close-bio
              class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-slate-700 transition hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
            >
              Close
            </button>
          </div>
          <div class="space-y-3 text-justify text-sm leading-relaxed text-slate-700 hyphens-auto">
            {
              person.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))
            }
            {
              person.links &&
                person.links.length > 0 && (
                  <p class="pt-1">
                    {person.links.map((link, index) => (
                      <>
                        <a
                          href={link.href}
                          class="link"
                          target={link.href.startsWith("http") ? "_blank" : undefined}
                          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                        >
                          {link.label}
                        </a>
                        {index < person.links.length - 1 ? ", " : ""}
                      </>
                    ))}
                  </p>
                )
            }
          </div>
        </article>
      </dialog>
    ))
  }
</BaseLayout>

<style>
  /* One shared team layout for Elders/Deacons and Staff so portraits are an
     identical size in both. Flex-wrap + centred rows keep an odd final row
     (e.g. 5 people = 4 + 1) balanced in the centre. */
  .team-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.25rem 1.5rem;
  }

  /* 2-up on mobile for both groups */
  .team-member {
    width: calc(50% - 0.75rem);
  }

  /* Elders/Deacons (5 people) -> 3-up, so the last row is 3 + 2 (never a lone item) */
  @media (min-width: 640px) {
    .team-grid--3 .team-member {
      width: calc((100% - 3rem) / 3);
    }
  }

  /* Staff (4 people) -> 4-up, a single balanced row */
  @media (min-width: 768px) {
    .team-grid--4 .team-member {
      width: calc((100% - 4.5rem) / 4);
    }
  }

  dialog.bio-dialog {
    width: min(92vw, 42rem);
    max-height: 85vh;
  }

  dialog.bio-dialog[open] {
    position: fixed;
    inset: 0;
    margin: auto;
  }

  dialog.bio-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
</style>

<script is:inline>
  (() => {
    const openButtons = document.querySelectorAll("[data-open-bio]");
    const closeButtons = document.querySelectorAll("[data-close-bio]");
    const dialogs = document.querySelectorAll("dialog[data-bio-dialog]");

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const dialogId = button.getAttribute("data-open-bio");
        if (!dialogId) return;
        const dialog = document.getElementById(dialogId);
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = button.closest("dialog");
        if (dialog instanceof HTMLDialogElement) {
          dialog.close();
        }
      });
    });

    dialogs.forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        const bounds = dialog.getBoundingClientRect();
        const clickInside =
          event.clientX >= bounds.left &&
          event.clientX <= bounds.right &&
          event.clientY >= bounds.top &&
          event.clientY <= bounds.bottom;

        if (!clickInside) {
          dialog.close();
        }
      });
    });
  })();
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import about from "../data/about.json";

const elders = about.leaders.filter((person) => person.team === "Elders and Deacons");
const staff = about.leaders.filter((person) => person.team === "Staff");
---

<BaseLayout
  title="About Us"
  description="Learn about Bethesda Christian Centre's story, vision, and leadership team."
  image="/images/logo_transparent_bg.png"
>
  <PageHero
    eyebrow="About Us"
    title="Our Story And Vision"
    description={about.intro[0]}
    image="/images/logo_transparent_bg.png"
    imageAlt="Bethesda Christian Centre logo"
  />

  <section aria-labelledby="about-story" class="mt-8 rounded-2xl border border-black/10 bg-white/85 p-6 md:p-8">
    <h2 id="about-story" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Who We Are</h2>
    <div class="mt-4 space-y-3 text-base leading-relaxed text-slate-700">
      {
        about.intro.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {
        about.vision.map((item) => (
          <article class="rounded-xl border border-slate-200 bg-slate-50 p-4">
            <h3 class="text-lg font-black text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-700">{item.description}</p>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-sm font-semibold text-slate-700">
      Read more about our statement of faith on
      <a
        href="/our-beliefs.html"
        class="underline decoration-slate-500 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
      >
        Our Beliefs
      </a>.
    </p>
  </section>

  <section aria-labelledby="leadership" class="mt-10">
    <h2 id="leadership" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Elders and Deacons</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        elders.map((person) => (
          <article class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
            <img
              src={person.image}
              alt={`Portrait of ${person.name}`}
              class="h-24 w-24 rounded-full border border-slate-200 object-cover"
              width="120"
              height="120"
              loading="lazy"
            />
            <h3 class="mt-3 text-lg font-black text-slate-900">{person.name}</h3>
            <p class="text-sm font-semibold text-slate-600">{person.role}</p>
            <button
              type="button"
              data-open-bio={`bio-${person.id}`}
              class="mt-3 inline-flex rounded-lg bg-[var(--bcc-blue)] px-3 py-2 text-xs font-black uppercase tracking-wide text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
            >
              Read bio
            </button>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="staff" class="mt-10">
    <h2 id="staff" class="text-2xl font-black tracking-tight text-slate-900 md:text-3xl">Staff</h2>
    <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        staff.map((person) => (
          <article class="rounded-2xl border border-black/10 bg-white/90 p-5 shadow-sm">
            <img
              src={person.image}
              alt={`Portrait of ${person.name}`}
              class="h-24 w-24 rounded-full border border-slate-200 object-cover"
              width="120"
              height="120"
              loading="lazy"
            />
            <h3 class="mt-3 text-lg font-black text-slate-900">{person.name}</h3>
            <p class="text-sm font-semibold text-slate-600">{person.role}</p>
            <button
              type="button"
              data-open-bio={`bio-${person.id}`}
              class="mt-3 inline-flex rounded-lg bg-[var(--bcc-yellow)] px-3 py-2 text-xs font-black uppercase tracking-wide text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
            >
              Read bio
            </button>
          </article>
        ))
      }
    </div>
  </section>

  {
    about.leaders.map((person) => (
      <dialog
        id={`bio-${person.id}`}
        data-bio-dialog
        aria-labelledby={`bio-title-${person.id}`}
        class="bio-dialog rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-950/55"
      >
        <article class="max-h-[85vh] w-full max-w-2xl overflow-auto p-5 md:p-7">
          <div class="mb-4 flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <img
                src={person.image}
                alt={`Portrait of ${person.name}`}
                width="64"
                height="64"
                class="h-14 w-14 rounded-full border border-slate-200 object-cover"
              />
              <div>
                <h3 id={`bio-title-${person.id}`} class="text-xl font-black tracking-tight text-slate-900">{person.name}</h3>
                <p class="text-sm font-semibold text-slate-600">{person.role}</p>
              </div>
            </div>
            <button
              type="button"
              data-close-bio
              class="rounded-md border border-slate-300 px-3 py-1.5 text-xs font-black uppercase tracking-wide text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
            >
              Close
            </button>
          </div>
          <div class="space-y-3 text-sm leading-relaxed text-slate-700">
            {
              person.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))
            }
            {
              person.links &&
                person.links.length > 0 && (
                  <p class="pt-1">
                    {person.links.map((link, index) => (
                      <>
                        <a
                          href={link.href}
                          class="font-bold underline decoration-slate-400 underline-offset-2 hover:text-slate-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-900"
                          target={link.href.startsWith("http") ? "_blank" : undefined}
                          rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                        >
                          {link.label}
                        </a>
                        {index < person.links.length - 1 ? ", " : ""}
                      </>
                    ))}
                  </p>
                )
            }
          </div>
        </article>
      </dialog>
    ))
  }
</BaseLayout>

<style>
  dialog.bio-dialog::backdrop {
    backdrop-filter: blur(2px);
  }
</style>

<script is:inline>
  (() => {
    const openButtons = document.querySelectorAll("[data-open-bio]");
    const closeButtons = document.querySelectorAll("[data-close-bio]");
    const dialogs = document.querySelectorAll("dialog[data-bio-dialog]");

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const dialogId = button.getAttribute("data-open-bio");
        if (!dialogId) return;
        const dialog = document.getElementById(dialogId);
        if (dialog instanceof HTMLDialogElement) {
          dialog.showModal();
        }
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const dialog = button.closest("dialog");
        if (dialog instanceof HTMLDialogElement) {
          dialog.close();
        }
      });
    });

    dialogs.forEach((dialog) => {
      dialog.addEventListener("click", (event) => {
        const bounds = dialog.getBoundingClientRect();
        const clickInside =
          event.clientX >= bounds.left &&
          event.clientX <= bounds.right &&
          event.clientY >= bounds.top &&
          event.clientY <= bounds.bottom;

        if (!clickInside) {
          dialog.close();
        }
      });
    });
  })();
</script>
